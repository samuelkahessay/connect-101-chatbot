# OpenRouter API Configuration
# Get your free API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-api-key-here

# Model Configuration
# Free models available:
# - google/gemini-flash-1.5:free (recommended - excellent quality)
# - meta-llama/llama-3.2-3b-instruct:free (fast, good quality)
# - qwen/qwen-2-7b-instruct:free (good multilingual support)
OPENROUTER_MODEL=google/gemini-flash-1.5:free
